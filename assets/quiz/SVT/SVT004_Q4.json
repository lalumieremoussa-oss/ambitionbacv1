      "bonne réponse": "B"
    },
    "question n°27": {
      "question": "La contraction cesse quand :",
      "réponses": {
        "A": "La bande sombre s’élargit",
        "B": "L’ATP est hydrolysé",
        "C": "La troponine se multiplie",
        "D": "La troponine se multiplie"
      },
      "bonne réponse": "D"
    },
    "question n°28": {
      "question": "La zone H est :",
      "réponses": {
        "A": "Inexistante",
        "B": "Riche en tropomyosine",
        "C": "Une zone sans myosine",
        "D": "Une zone sans actine"
